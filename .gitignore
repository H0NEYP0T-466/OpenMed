# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node dependencies & builds
node_modules/
dist/
dist-ssr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ML Weights & Checkpoints (Never commit large weights)
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.ckpt
*.h5
checkpoints/*.pth
checkpoints/*.pt
!checkpoints/.gitkeep
weights/

# Training Outputs, Artifacts & Bundles
artifacts/
training_log.csv
brain_classification_results.zip
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# 3D Models & Atlas Assets (Stored locally in public/models/ or downloaded via script)
public/models/
*.glb
*.gltf

# Medical Datasets & Scans (Never commit raw datasets to git)
datasets/
backend/datasets/
storage/
data/
*.nii
*.nii.gz
*.dcm

# Environment variables & Local Secrets
.env
.env.*
!.env.example
.shots/
