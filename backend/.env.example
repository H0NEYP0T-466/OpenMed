# OpenMed backend configuration. Copy to .env and adjust, or export in the shell.
# Nothing here is required for local development; every value has a safe default.

# Where the trained brain checkpoint lives. Defaults to
# backend/app/organs/brain/classification/checkpoints/brain_best_model.pth
# OPENMED_BRAIN_CHECKPOINT=/absolute/path/to/brain_best_model.pth

# Brain dataset root (directory, DATA.json, or archive zip). Used by the
# training entrypoint and by /api/brain/model-info for dataset statistics.
# OPENMED_BRAIN_DATASET=/absolute/path/to/datasets/brain/archive

# Where a training run writes checkpoints, artefacts and the results zip.
# Required on Kaggle: the notebook working directory is /kaggle/working.
# OPENMED_BRAIN_OUTPUT=/kaggle/working

# Comma-separated browser origins allowed to call the API.
# "*" is permitted but then credentials are automatically disabled.
# OPENMED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server binding.
# OPENMED_HOST=0.0.0.0
# OPENMED_PORT=8016
# OPENMED_RELOAD=1

# Frontend (Vite) — set in the project root .env, not here:
# VITE_BRAIN_API_BASE=http://localhost:8016/api/brain
