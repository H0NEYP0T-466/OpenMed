# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Local Secrets
.env
.env.*
!.env.example

# Large Model Weights & Checkpoints (Heavy binary weights)
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.ckpt
*.h5
*.pkl
weights/
checkpoints/*.pth
checkpoints/*.pt
!checkpoints/.gitkeep

# Archives & ZIP files (Only the zip bundles are ignored, visuals and logs are tracked)
brain_classification_results.zip
*.zip
*.tar
*.tar.gz

# Medical Datasets & Scans (Raw datasets)
datasets/
data/
storage/
*.nii
*.nii.gz
*.dcm

# Temporary Files
tmp/
