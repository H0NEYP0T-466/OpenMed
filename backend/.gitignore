artifacts/
training_log.csv
brain_classification_results.zip
*.zip
*.tar
*.tar.gz

# Medical Datasets & Scans
datasets/
data/
storage/
*.nii
*.nii.gz
*.dcm

# Logs & Temporary Files
*.log
logs/
tmp/
