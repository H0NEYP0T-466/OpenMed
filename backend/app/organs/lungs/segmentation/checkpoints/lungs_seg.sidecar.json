{
  "checkpoint": "lungs_seg.pth",
  "format_version": 1,
  "kind": "lungs_segformer_two_head_seg",
  "label_space": {
    "task": "COVID opacity segmentation",
    "heads": [
      "lung",
      "opacity"
    ],
    "heads_trained": [
      "lung",
      "opacity"
    ],
    "merge_legend": [
      {
        "value": 0,
        "name": "Background"
      },
      {
        "value": 1,
        "name": "Lung field"
      },
      {
        "value": 2,
        "name": "COVID-type opacity (within the lung field)"
      }
    ],
    "merge_rule": "0 background, 1 lung field only, 2 opacity clipped to the lung field"
  },
  "architecture": {
    "encoder": "mit-b0",
    "heads": [
      "lung",
      "opacity"
    ],
    "hidden_sizes": [
      32,
      64,
      160,
      256
    ],
    "depths": [
      2,
      2,
      2,
      2
    ],
    "num_attention_heads": [
      1,
      2,
      5,
      8
    ],
    "sr_ratios": [
      8,
      4,
      2,
      1
    ],
    "patch_sizes": [
      7,
      3,
      3,
      3
    ],
    "strides": [
      4,
      2,
      2,
      2
    ],
    "mlp_ratios": [
      4,
      4,
      4,
      4
    ],
    "decoder_dim": 256,
    "head_dim": 64,
    "drop_path": 0.1,
    "decoder_dropout": 0.1,
    "head_dropout": 0.1,
    "encoder_dropout": 0.0,
    "attention_dropout": 0.0
  },
  "preprocess": {
    "version": 1,
    "image_size": 256,
    "channels_in": 1,
    "channels_model": 3,
    "decode": "cv2 grayscale",
    "resize": "to 256x256; INTER_AREA down / INTER_LINEAR up; native 256 is untouched",
    "clahe": false,
    "normalise": {
      "scale": "uint8 / 255",
      "replicate_to_channels": 3,
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "mask": "binarise at >= 128; resample INTER_LINEAR then >= 0.5",
    "opacity_crop": {
      "source": "bounding box of the lung field (ground truth in training, predicted at serving)",
      "margin_fraction": 0.06,
      "min_side_px": 64,
      "resize": "INTER_LINEAR to 256x256 (aspect ratio is not preserved)"
    }
  },
  "preprocess_version": 1,
  "postprocess": {
    "lung": {
      "threshold": 0.5,
      "min_area_frac": 0.0,
      "keep_largest_k": 2,
      "fill_holes": true,
      "tta_hflip": true,
      "tuned_on_validation": true
    },
    "opacity": {
      "threshold": 0.3,
      "min_area_frac": 0.005,
      "tta_hflip": true,
      "tuned_on_validation": true
    }
  },
